generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Unpooled Neon host (no "-pooler"). Used for prisma migrate; runtime uses DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum AthleteRole {
  USER          // Default - regular user
  CLUB_LEADER   // Club leader - can manage their RunClub's CityRuns
  AMBASSADOR    // Ambassador - can manage their RunClub's CityRuns (future)
}

/// At most one ACTIVE training plan per athlete (enforced in application code).
enum TrainingPlanLifecycle {
  ACTIVE
  ARCHIVED
  /// Plan paused on purpose — athlete can pick up later (replaces OLD_PLAN_UNUSED).
  PARKED
}

enum AthletePresetFitnessPhase {
  PEAK
  BASE
}

enum CoachReviewStatus {
  DRAFT
  PUBLISHED
}

/// Visibility for athlete-authored global training plan listings.
enum PublicTrainingPlanVisibility {
  DRAFT
  PUBLIC
  ARCHIVED
}

/// Plan-scoped custom workouts — not catalogue items.
enum PlanCustomWorkoutVisibility {
  PRIVATE
  PUBLIC_WITH_PLAN
}

/// Role of a race inside a specific training plan timeline.
model Athlete {
  id                      String                   @id @default(uuid())
  firebaseId              String                   @unique
  email                   String?
  companyId               String
  firstName               String?
  lastName                String?
  gofastHandle            String?                  @unique
  photoURL                String?
  /// GoFast Page hero — finish line / action shot (public). URL string.
  myBestRunPhotoURL       String?
  phoneNumber             String?
  birthday                DateTime?
  gender                  String?
  city                    String?
  state                   String?
  primarySport            String?
  bio                     String?
  instagram               String?
  /// Instagram Graph API connection metadata. Token stays server-side only.
  instagramUserId         String?                  @unique
  instagramUsername       String?
  instagramAccountType    String?
  instagramAccessTokenEncrypted String?
  instagramTokenExpiresAt DateTime?
  instagramConnectedAt    DateTime?
  instagramLastSyncedAt   DateTime?
  /// Opt-in: GoFast Page acts as a lightweight community (membership + chatter).
  isGoFastContainer       Boolean                  @default(false)
  garmin_user_id          String?                  @unique
  garmin_access_token      String?
  garmin_refresh_token     String?
  garmin_expires_in        Int?
  garmin_scope             String?
  garmin_connected_at      DateTime?
  garmin_last_sync_at      DateTime?
  garmin_is_connected      Boolean                  @default(false)
  garmin_disconnected_at   DateTime?
  garmin_permissions       Json?
  garmin_user_profile      Json?
  garmin_user_sleep        Json?
  garmin_user_daily        Json?
  garmin_user_preferences  Json?
  strava_id               Int?                     @unique
  strava_access_token     String?
  strava_refresh_token    String?
  strava_expires_at       Int?
  fiveKPace               String?
  /// Tempo-derived sustained pace (formatted like fiveKPace); updated from successful Tempo completions only.
  thresholdPace           String?
  /// Estimated upper heart rate (bpm) for truly easy aerobic work; updated conservatively from Easy/LongRun completions.
  aerobicCeilingBpm       Int?
  /// Best completed long run — adjusts GoFast race projection k-coefficient.
  longRunCapabilityMiles          Float?
  longRunCapabilityPaceSecPerMile   Int?
  longRunCapabilityDate           DateTime?
  /// Functional threshold power (watts) — bike workout intensity anchor.
  ftpWatts                Int?
  /// 400m benchmark expressed as seconds per 100m (not raw 400m time). Swim pace anchor for plan materialization.
  FourHunMSwPace          Int?
  /// Per run-type sec/mi nudge at materialization: target = 5K + catalogue offset + adjuster.
  paceAdjusterEasySecPerMile      Int @default(-10)
  paceAdjusterLongRunSecPerMile   Int @default(-20)
  paceAdjusterThresholdSecPerMile Int @default(-20)
  paceAdjusterIntervalSecPerMile  Int @default(-10)
  weeklyMileage           Int?
  role                    AthleteRole               @default(USER)
  runClubId               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  /// Login hydrate — copied from isPrimaryRace athlete_races row by align service only.
  goalRaceName            String?
  /// Login hydrate — copied from primary athlete_races.goalTime by align service only.
  goalRaceTime            String?
  /// Last app bootstrap (GET /api/athlete/me or POST /api/athlete/create)
  lastSeenAt              DateTime?
  /// Rolling 90d avg weekly miles from athlete_activities — populated by cron, not computed on read.
  avgWeeklyMilesSnapshot  Float?
  /// When avgWeeklyMilesSnapshot was last written by the mileage cron.
  mileageSnapshotUpdatedAt DateTime?
  /// Stripe Express Connect — athlete sponsorship payout destination.
  stripeConnectAccountId        String?   @map("stripe_connect_account_id")
  stripeConnectChargesEnabled     Boolean   @default(false) @map("stripe_connect_charges_enabled")
  stripeConnectPayoutsEnabled     Boolean   @default(false) @map("stripe_connect_payouts_enabled")
  stripeConnectDetailsSubmitted   Boolean   @default(false) @map("stripe_connect_details_submitted")
  stripeConnectRequirementsJson   Json?     @map("stripe_connect_requirements_json")
  stripeConnectOnboardedAt        DateTime? @map("stripe_connect_onboarded_at")
  /// Club Manager UX state — welcomed clubs (first-ack), not membership authority.
  clubManagerState        Json?
  go_fast_companies       go_fast_companies        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runClub                 run_clubs?               @relation(fields: [runClubId], references: [id], onDelete: SetNull)
  ambassador_credits      ambassador_credits[]
  ambassador_payouts      ambassador_payouts[]
  athlete_activities      athlete_activities[]
  athlete_health_records  athlete_health_records[]
  run_crew_announcements  run_crew_announcements[]
  run_crew_event_rsvps    run_crew_event_rsvps[]
  run_crew_events         run_crew_events[]
  run_crew_memberships    run_crew_memberships[]
  run_crew_messages       run_crew_messages[]
  run_club_memberships    run_club_memberships[]
  run_club_leader_claims    run_club_leader_claims[]
  athlete_product_roles   athlete_product_roles[]
  run_club_announcements  run_club_announcements[]
  run_club_events         run_club_events[]
  run_club_event_rsvps    run_club_event_rsvps[]
  run_club_messages       run_club_messages[]
  chatter_channel_reads   chatter_channel_reads[]
  city_run_rsvps          city_run_rsvps[]
  city_run_messages       city_run_messages[]
  city_run_checkins       city_run_checkins[]
  city_run_activity_links city_run_activity_links[]
  city_runs               city_runs[]
  routes                  routes[]
  training_plans          training_plans[]
  athlete_presets         athlete_presets[]
  athlete_owned_catalogue workout_catalogue[]
  workouts                workouts[]
  bike_workouts           bike_workout[]
  swim_workouts           swim_workout[]
  tri_workouts            tri_workout[]
  athlete_races           athlete_races[]
  athlete_race_results    athlete_race_results[]
  race_memberships        race_memberships[]
  training_cohort_memberships training_cohort_memberships[]
  training_cohort_messages training_cohort_messages[]
  race_messages           race_messages[]
  race_announcements      race_announcements[]
  race_events_organized   race_events[]            @relation("RaceEventOrganizer")
  race_event_rsvps        race_event_rsvps[]
  training_preferences    TrainingPreferences?
  run_journal_entries     run_journal_entries[]
  pace_adjustment_logs    pace_adjustment_log[]
  hosted_container_memberships  gofast_container_memberships[] @relation("ContainerHost")
  member_container_memberships   gofast_container_memberships[] @relation("ContainerMember")
  container_messages_as_host     gofast_container_messages[]    @relation("ContainerMessages")
  container_messages_as_author   gofast_container_messages[]    @relation("ContainerMessageAuthor")
  hosted_training_cohorts      training_cohorts[]               @relation("TrainingCohortHost")
  authored_public_training_plans public_training_plans[]        @relation("PublicPlanAuthor")
  plan_custom_workouts         plan_custom_workouts[]
  planned_workouts             planned_workouts[]
  athlete_appnotification_devices     athlete_appnotification_devices[]
  gofast_with_me              gofast_with_me?
  athlete_tips                athlete_tips[]
  athlete_run_routes          athlete_run_routes[]
  athlete_activity_posts      athlete_activity_posts[]
  athlete_instagram_media     athlete_instagram_media[]
  sponsorship_candidate sponsorship_candidates?
  sponsorships                sponsorships[]
}

enum SponsorshipCandidateType {
  ATHLETE
}

enum SponsorshipCandidateStatus {
  ELIGIBLE
  PAUSED
  RETIRED
}

enum SponsorCommitmentPaymentStatus {
  UNPAID
  CHECKOUT_PENDING
  PAID
  FAILED
  REFUNDED
}

enum SponsorCommitmentStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELED
}

enum SponsorCommitmentPaymentLifecycle {
  CHECKOUT_PENDING
  PAID
  TRANSFERRED
  REFUNDED
  FAILED
}

enum SponsorshipDeliveryStatus {
  SCHEDULED
  LIVE
  FINISHED
}

/// Athlete (or future surface) eligible for Brand Partnerships inventory.
model sponsorship_candidates {
  id                 String                     @id @default(uuid())
  code               String                     @unique
  candidateType      SponsorshipCandidateType   @default(ATHLETE)
  athleteId          String                     @unique
  status             SponsorshipCandidateStatus @default(ELIGIBLE)
  publicSlugSnapshot String?
  displayLabel       String?
  photoUrl           String?
  eligibleAt         DateTime?
  pausedAt           DateTime?
  retiredAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  athlete      Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  commitments  sponsor_commitments[]
  sponsorships sponsorships[]

  @@index([status])
  @@index([candidateType, status])
  @@map("sponsorship_candidates")
}

/// Flat Brand Partnerships runtime + payment record (Prod-owned).
model sponsor_commitments {
  id                      String                         @id @default(uuid())
  candidateId             String
  candidateCodeSnapshot   String
  brandId                 String
  brandUserId             String?
  brandNameSnapshot       String?
  brandLogoUrlSnapshot    String?
  creativeUrl             String?
  ctaUrl                  String?
  startsAt                DateTime
  endsAt                  DateTime
  pricingRuleKey          String
  pricingRuleVersion      Int                            @default(1)
  pricingBreakdownJson    Json?
  quotedAmountCents       Int
  amountPaidCents         Int?
  currency                String                         @default("usd")
  athleteShareCents       Int?
  platformShareCents      Int?
  stripeBrandCustomerId   String?
  stripeConnectAccountId  String?
  payoutConfigKey         String?
  payoutConfigVersion     Int?
  athleteSharePercent     Int?
  platformSharePercent    Int?
  paymentStatus           SponsorCommitmentPaymentStatus @default(UNPAID)
  status                  SponsorCommitmentStatus          @default(DRAFT)
  stripeCheckoutSessionId String?                        @unique
  stripePaymentIntentId   String?                        @unique
  paidAt                  DateTime?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  candidate   sponsorship_candidates @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  payments    sponsor_commitment_payments[]
  sponsorship sponsorships?

  @@index([candidateId, status])
  @@index([candidateId, startsAt, endsAt])
  @@index([status, endsAt])
  @@index([paymentStatus])
  @@index([brandId])
  @@map("sponsor_commitments")
}

/// Live ad hydration spawned from a paid sponsor_commitment receipt.
model sponsorships {
  id                   String                    @id @default(uuid())
  sponsorCommitmentId  String                    @unique
  candidateId          String
  athleteId            String
  brandId              String
  name                 String?
  brandLogoUrlSnapshot String?
  creativeUrl          String?
  ctaUrl               String?
  cpmAmount            Int                       @default(0)
  cpmUsed              Int                       @default(0)
  startsAt             DateTime
  endsAt               DateTime
  status               SponsorshipDeliveryStatus @default(SCHEDULED)
  finishedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  commitment sponsor_commitments    @relation(fields: [sponsorCommitmentId], references: [id], onDelete: Cascade)
  candidate  sponsorship_candidates @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  athlete    Athlete                @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, status])
  @@index([candidateId, status])
  @@index([status, endsAt])
  @@index([brandId])
  @@map("sponsorships")
}

/// Commitment-scoped payment/transaction record (mirrors run_program_registration_success_payments).
model sponsor_commitment_payments {
  id                       String                            @id @default(uuid())
  sponsorCommitmentId      String
  stripeBrandCustomerId    String?
  stripeCheckoutSessionId  String?                           @unique
  stripePaymentIntentId    String?                           @unique
  stripeChargeId           String?                           @unique
  stripeTransferId         String?
  stripeApplicationFeeId   String?
  stripeProcessingFeeCents Int?
  stripeConnectAccountId   String?
  grossAmountCents         Int
  athleteShareCents        Int
  platformShareCents       Int
  currency                 String                            @default("usd")
  payoutConfigKey          String?
  payoutConfigVersion      Int?
  athleteSharePercent      Int?
  platformSharePercent     Int?
  lifecycle                SponsorCommitmentPaymentLifecycle @default(CHECKOUT_PENDING)
  paidAt                   DateTime?
  transferredAt            DateTime?
  createdAt                DateTime                          @default(now())
  updatedAt                DateTime                          @updatedAt

  commitment sponsor_commitments @relation(fields: [sponsorCommitmentId], references: [id], onDelete: Cascade)

  @@index([sponsorCommitmentId])
  @@index([lifecycle])
  @@map("sponsor_commitment_payments")
}

/// Athlete-scoped GoFast With Me — public invite identity (not the human Athlete profile).
model gofast_with_me {
  id                 String   @id @default(cuid())
  athleteId          String   @unique
  /// Public URL key for visitor lookup; may match gofastHandle or be custom.
  gofastSlugSnapshot String   @unique
  /// When true, slug follows Athlete.gofastHandle on handle change.
  slugUsesHandle     Boolean  @default(true)
  welcome            String?  @db.Text
  gofastWithMeBio    String?  @db.Text
  whatYoullSeeHere   String?  @db.Text
  sportFocus         String?
  modelFocus         String?
  myAchievements     String?  @db.Text
  /// Public landing hero / action image (not Athlete profile photo).
  gofastWithMePhotoUrl String?
  /// Focal point for object-cover framing (0–100). Default center when null.
  gofastWithMePhotoFocusX Int? @default(50)
  gofastWithMePhotoFocusY Int? @default(50)
  /// Zoom for landing photo framing (1.0–3.0). Default 1 when null.
  gofastWithMePhotoZoom Float? @default(1)
  /// Layout hint: action, group, race, portrait, other — drives surface framing.
  gofastWithMePhotoType String?
  /// Hub creator framing: "person" or "coach" (not the separate Coach entity).
  creatorType        String?
  /// Coach positioning when creatorType = "coach".
  coachSpecialty     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  athlete            Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("gofast_with_me")
}

/// Athlete-scoped durable public tips (CMS content — not container feed posts).
model athlete_tips {
  id          String    @id @default(cuid())
  athleteId   String
  title       String
  /// The Big Idea — long-form tip content.
  body        String    @db.Text
  /// Optional short actionable takeaway.
  takeaway    String?   @db.Text
  /// Optional structured series: { title?: string, tips: { title: string, body: string }[] }
  tipSeries   Json?
  /// Optional Vercel Blob URL for tip image or short video.
  mediaUrl    String?
  /// `image` | `video` when mediaUrl is set.
  mediaType   String?
  sortOrder      Int       @default(0)
  isPublished    Boolean   @default(false)
  showOnLanding  Boolean   @default(true)
  showOnFeed     Boolean   @default(true)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  athlete        Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, sortOrder])
  @@index([athleteId, isPublished])
  @@map("athlete_tips")
}

/// Per-athlete curation of shared catalog routes (myRunRoutes CMS).
model athlete_run_routes {
  id          String    @id @default(cuid())
  athleteId   String
  routeId     String
  caption     String?   @db.Text
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  route       routes    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([athleteId, routeId])
  @@index([athleteId, sortOrder])
  @@index([athleteId, isPublished])
  @@map("athlete_run_routes")
}

/// Athlete-authored social overlay on a synced activity — caption, photo, hub publish.
model athlete_activity_posts {
  id                 String             @id @default(cuid())
  athleteId          String
  activityId         String             @unique
  caption            String?            @db.Text
  photoUrl           String?
  showMatchedWorkout Boolean            @default(true)
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  athlete            Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  activity           athlete_activities @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([athleteId, publishedAt])
  @@map("athlete_activity_posts")
}

/// Public-safe Instagram media snapshot for hydrating athlete public/community surfaces.
model athlete_instagram_media {
  id               String   @id @default(cuid())
  athleteId        String
  instagramMediaId String
  mediaType        String
  mediaUrl         String?
  thumbnailUrl     String?
  permalink        String?
  caption          String?  @db.Text
  timestamp        DateTime?
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  athlete          Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, instagramMediaId])
  @@index([athleteId, timestamp])
  @@map("athlete_instagram_media")
}

/// Human coach — first-class entity (Firebase auth), parallel to Athlete.
model Coach {
  id         String   @id @default(cuid())
  firebaseId String   @unique
  email      String?
  companyId  String
  firstName  String?
  lastName   String?
  photoURL   String?
  bio        String?
  specialty  String?
  city       String?
  state      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  go_fast_companies go_fast_companies @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("coaches")
}

/// Weekly batch analysis result OR per-workout match notification.
/// notificationType: 'PACE_UPDATE' (weekly credit) | 'WORKOUT_MATCH' (per-workout feedback).
/// Pace fields are nullable — only set for PACE_UPDATE rows.
model pace_adjustment_log {
  id                           String         @id @default(cuid())
  athleteId                    String
  planId                       String?
  weekNumber                   Int?
  workoutId                    String?
  notificationType             String?        @default("PACE_UPDATE")
  previousPaceSecPerMile       Int?
  newPaceSecPerMile            Int?
  adjustmentSecPerMile         Int?
  longRunCompleted             Boolean        @default(false)
  longRunCompletionRatio       Float?
  weeklyMileageCompletionPct   Float?
  summaryMessage               String?
  seenAt                       DateTime?
  createdAt                    DateTime       @default(now())
  Athlete                      Athlete        @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  training_plans               training_plans? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([athleteId, seenAt])
  @@index([planId, weekNumber])
}

model gofast_container_memberships {
  id                 String   @id @default(cuid())
  containerAthleteId String
  memberAthleteId    String
  role               String   @default("member")
  joinedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  containerAthlete   Athlete  @relation("ContainerHost", fields: [containerAthleteId], references: [id], onDelete: Cascade)
  memberAthlete      Athlete  @relation("ContainerMember", fields: [memberAthleteId], references: [id], onDelete: Cascade)

  @@unique([containerAthleteId, memberAthleteId])
  @@index([containerAthleteId])
}

model gofast_container_messages {
  id                 String   @id @default(cuid())
  containerAthleteId String
  authorAthleteId    String
  body               String
  /// updates | tips | nutrition | routes | chatter
  topic              String   @default("chatter")
  routeId            String?
  /// Optional joinable run invite attached to a feed post (host-owned city_runs).
  cityRunId          String?
  createdAt          DateTime @default(now())
  containerAthlete   Athlete  @relation("ContainerMessages", fields: [containerAthleteId], references: [id], onDelete: Cascade)
  authorAthlete      Athlete  @relation("ContainerMessageAuthor", fields: [authorAthleteId], references: [id], onDelete: Cascade)
  route              routes?  @relation(fields: [routeId], references: [id], onDelete: SetNull)
  cityRun            city_runs? @relation(fields: [cityRunId], references: [id], onDelete: SetNull)

  @@index([containerAthleteId, createdAt])
  @@index([containerAthleteId, topic, createdAt])
  @@index([cityRunId])
}

model ambassador_credits {
  id              String           @id @default(cuid())
  athleteId       String
  cityRunRsvpId   String           @unique         // One credit per RSVP (RSVP going + photo)
  amountCents     Int              @default(1000)  // $10 per qualified run
  createdAt       DateTime         @default(now())
  Athlete         Athlete          @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  city_run_rsvps  city_run_rsvps   @relation(fields: [cityRunRsvpId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([createdAt])
}

model ambassador_payouts {
  id               String    @id @default(cuid())
  athleteId        String
  processedAt      DateTime  // When Company paid (period end for credits)
  amountCents      Int
  companyPayoutId  String?   // FK/id from GoFast Company payouts table (if synced)
  createdAt        DateTime  @default(now())
  Athlete          Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([processedAt])
}

model athlete_activities {
  id               String            @id
  athleteId        String
  sourceActivityId String            @unique
  source           String            @default("garmin")
  /// RECEIVED | MATCHED | UNMATCHED | INELIGIBLE — ingest → promote lifecycle
  ingestionStatus  String            @default("RECEIVED")
  activityType     String?
  activityName     String?
  startTime        DateTime?
  duration         Int?
  distance         Float?
  calories         Int?
  averageSpeed     Float?
  averageHeartRate Int?
  maxHeartRate     Int?
  elevationGain    Float?
  averagePower     Int?
  steps            Int?
  startLatitude    Float?
  startLongitude   Float?
  endLatitude      Float?
  endLongitude     Float?
  summaryPolyline  String?
  summaryData      Json?
  detailData       Json?
  hydratedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  Athlete          Athlete           @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  matched_workout  workouts?         @relation("WorkoutMatchedActivity")
  matched_bike_workout bike_workout? @relation("BikeWorkoutMatchedActivity")
  city_run_activity_links city_run_activity_links[]
  athlete_race_result athlete_race_results?
  workout_segment_laps workout_segment_laps[]
  activity_post        athlete_activity_posts?

  @@index([athleteId, ingestionStatus])
}

/// Garmin Health API summaries (dailies, sleeps) — off Athlete row to avoid profile bloat.
model athlete_health_records {
  id              String    @id @default(cuid())
  athleteId       String
  source          String    @default("garmin")
  /// "daily" | "sleep" — matches Garmin Health webhook keys (dailies, sleeps)
  healthType      String
  sourceSummaryId String?
  calendarDate    DateTime?
  summaryData     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Athlete         Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([source, healthType, sourceSummaryId])
  @@index([athleteId, healthType, calendarDate])
}

/// Athlete linked a synced activity (or attendance-only) to a city run for credit / history.
model city_run_activity_links {
  id             String   @id @default(cuid())
  cityRunId      String
  athleteId      String
  activityId     String?
  linkedManually Boolean  @default(true)
  createdAt      DateTime @default(now())

  city_runs          city_runs           @relation(fields: [cityRunId], references: [id], onDelete: Cascade)
  Athlete            Athlete             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  athlete_activities athlete_activities? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([cityRunId, athleteId])
  @@index([athleteId])
  @@index([activityId])
}

model cities {
  id            String          @id
  slug          String          @unique
  name          String
  state         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  run_clubs     run_clubs[]
  run_series    run_series[]
  city_runs     city_runs[]
  routes        routes[]
  run_locations run_locations[]

  @@index([name])
  @@index([slug])
}

model go_fast_companies {
  id        String    @id
  name      String?
  slug      String?   @unique
  address   String?
  city      String?
  state     String?
  zip       String?
  domain    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Athlete   Athlete[]
  Coach     Coach[]
}

model join_codes {
  id        String    @id
  code      String    @unique
  runCrewId String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  run_crews run_crews @relation(fields: [runCrewId], references: [id], onDelete: Cascade)
}

// TODO(race-prep): Athlete-facing course preview / training-plan tie-in may need a
// race_registry_courses junction or companyRaceId reference to structured course data.
// Company remains canonical for course geometry; do not duplicate until feature is scoped.

model race_registry {
  id                      String                    @id
  name                    String
  city                    String?
  state                   String?
  country                 String?                   @default("USA")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  charityName             String?
  charityUrl              String?
  courseMapUrl            String?
  /// Public content site /course/[slug] — from Company race_courses.slug (prodpush).
  courseSlug              String?
  description             String?
  /// Short tagline / card summary (from Company sync).
  summaryPhrase           String?
  /// Canonical race distance in meters (aligned with GoFastCompany race_registrations).
  distanceMeters          Int?
  isActive                Boolean                   @default(true)
  isCancelled             Boolean                   @default(false)
  isVirtual               Boolean                   @default(false)
  officialWebsiteUrl      String?
  raceDate                DateTime
  registrationCloseDate   DateTime?
  /// Capacity closed before deadline (e.g. sold out); hides external registration CTA.
  registrationSoldOut     Boolean                   @default(false)
  /// Last calendar day for official bib transfers (separate from registration close).
  transferDeadline        DateTime?
  registrationFee         Float?
  registrationOpenDate    DateTime?
  registrationOpenNow     Boolean                   @default(false)
  registrationUrl         String?
  resultsUrl              String?
  slug                    String?                   @unique
  /// Wall-clock label from GoFastCompany (e.g. "10:00 AM"); not a timezone-aware instant.
  startTime               String?
  tags                    String[]                  @default([])
  /// When set, matches GoFastCompany races.id (multiple registry rows per race = multiple distances).
  companyRaceId           String?
  /// GoFastCompany race_registrations.id — stable upsert key per distance.
  companyRegistrationId   String?                   @unique
  /// Companion distances (5K, 10 Mile…) point to the primary/marathon row.
  parentRaceId            String?
  parentRace              race_registry?            @relation("RaceFamily", fields: [parentRaceId], references: [id])
  childRaces              race_registry[]           @relation("RaceFamily")
  /// External image URL for browse cards (editorial asset or CDN).
  logoUrl                 String?
  /// Distance label from registration or pipe-joined snapshot from company sync.
  distanceLabel           String?
  /// Racer-facing snapshot from Company; set by sync only.
  packetPickupLocation     String?
  packetPickupDate         DateTime?
  packetPickupTime         String?
  packetPickupDescription  String?
  spectatorInfo           String?
  logisticsInfo           String?
  gearDropInstructions    String?
  run_crew_specific_races  run_crew_specific_races[]
  run_crews                run_crews[]
  training_plans           training_plans[]
  training_cohorts         training_cohorts[]
  training_cohort_memberships training_cohort_memberships[]
  athlete_races            athlete_races[]
  athlete_race_results     athlete_race_results[]
  race_memberships         race_memberships[]
  race_messages            race_messages[]
  race_announcements       race_announcements[]
  race_events              race_events[]
  city_runs_tagged         city_runs[]               @relation("CityRunRaceRegistry")
  course_segments          race_registry_course_segments[]

  @@index([city, state])
  @@index([isActive])
  @@index([raceDate])
  @@index([slug])
  @@index([tags])
  @@index([companyRaceId])
  @@index([parentRaceId])
  @@index([companyRegistrationId])
}

/// Course segments mirrored from GoFastCompany race_course_segments (prodpush).
model race_registry_course_segments {
  id               String        @id @default(cuid())
  raceRegistryId   String
  /// GoFastCompany race_course_segments.id
  companySegmentId String        @unique
  order            Int
  name             String
  mileMarker       String?
  description      String?
  runTip           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  raceRegistry     race_registry @relation(fields: [raceRegistryId], references: [id], onDelete: Cascade)

  @@index([raceRegistryId])
}

/// Athlete's claimed race snapshot — working set for training (origin: race_registry).
model athlete_races {
  id               String   @id @default(cuid())
  athleteId        String
  raceRegistryId   String
  /// Snapshot at claim — not live registry reads for training rules.
  name             String
  raceDate         DateTime
  distanceMeters   Int?
  distanceLabel    String?
  city             String?
  state            String?
  /// Snapshot at claim — public slug for content links.
  slug             String?
  /// Snapshot at claim — race logo for athlete-scoped display.
  logoUrl          String?
  /// Goal fields — every claimed race carries the athlete's goal for that race.
  goalName             String?
  goalDescription      String?  @db.Text
  goalDistance         String?
  goalTime             String?
  goalRacePace         Int?
  goalPace5K           Int?
  whyGoal              String?  @db.Text
  successLooksLike     String?  @db.Text
  completionFeeling    String?  @db.Text
  motivationIcon       String?
  /// Athlete-selected Goal race for cheer-on / public primary — at most one per athlete.
  isPrimaryRace    Boolean  @default(false)
  selfDeclaredAt   DateTime @default(now())
  notifyEnabled    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  Athlete                   Athlete                     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race_registry             race_registry               @relation(fields: [raceRegistryId], references: [id], onDelete: Cascade)
  athlete_race_result       athlete_race_results?
  training_plans            training_plans[]            @relation("PlanAthleteRace")

  @@unique([athleteId, raceRegistryId])
  @@index([athleteId])
  @@index([raceRegistryId])
  @@index([raceDate])
  @@index([athleteId, isPrimaryRace])
  @@map("athlete_races")
}

/// Persisted finish data for a race (manual or linked Garmin activity).
model athlete_race_results {
  id                     String   @id @default(cuid())
  athleteId              String
  raceRegistryId         String
  athleteRaceId          String?  @unique
  /// Primary display time — chip or net when that is the official "finish" (string "H:MM:SS" or "MM:SS").
  officialFinishTime     String?
  chipTime               String?
  gunTime                String?
  /// Net finish in seconds (for goal / PR analysis).
  finishTimeSeconds      Int?
  /// Goal time in seconds (snapshot from athlete_races.goalTime at log time).
  goalTimeSeconds        Int?
  /// finishTimeSeconds - goalTimeSeconds; negative = beat goal (faster).
  goalTimeDeltaSeconds   Int?
  goalAchieved           Boolean  @default(false)
  prAchieved             Boolean  @default(false)
  /// Prior best for same distance (seconds) when PR was set.
  previousPrSeconds      Int?
  /// When the race was run (defaults from registry or goal).
  raceDate               DateTime?
  /// Snapshot: Marathon, 5K, etc.
  distanceLabel          String?
  reflection             String?  @db.Text
  /// Public URLs (e.g. Vercel Blob) for race-day photos; no enforced max count.
  racePhotoUrls          String[] @default([])
  howFeltRating          Int?
  actualDistanceMeters     Float?
  actualAvgPaceSecPerMile  Int?
  overallPlace           Int?
  ageGroupPlace          Int?
  divisionPlace          Int?
  source                 String   @default("manual")
  /// Optional link to a synced `athlete_activities` row (e.g. Garmin).
  garminActivityId       String?  @unique
  notes                  String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  Athlete              Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  race_registry        race_registry      @relation(fields: [raceRegistryId], references: [id], onDelete: Cascade)
  athlete_race         athlete_races?        @relation(fields: [athleteRaceId], references: [id], onDelete: SetNull)
  athlete_activity     athlete_activities?  @relation(fields: [garminActivityId], references: [id], onDelete: SetNull)

  @@unique([athleteId, raceRegistryId])
  @@index([athleteId])
  @@index([raceRegistryId])
  @@map("athlete_race_results")
}

/// Join a race registry → access race chatter and container features (mirrors run_crew_memberships).
model race_memberships {
  id        String         @id @default(cuid())
  raceId    String
  athleteId String
  role      RaceMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  race_registry race_registry @relation(fields: [raceId], references: [id], onDelete: Cascade)
  Athlete       Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([raceId, athleteId])
  @@index([raceId])
  @@index([athleteId])
  @@map("race_memberships")
}

/// Race-scoped chatter (mirrors run_crew_messages).
model race_messages {
  id        String   @id @default(cuid())
  raceId    String
  athleteId String
  content   String
  topic     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  race_registry race_registry @relation(fields: [raceId], references: [id], onDelete: Cascade)
  Athlete       Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([raceId])
  @@index([athleteId])
  @@map("race_messages")
}

model race_announcements {
  id               String    @id @default(cuid())
  raceId           String
  authorId         String?
  staffGeneratedId String?
  title            String
  content          String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  archivedAt       DateTime?

  race_registry race_registry @relation(fields: [raceId], references: [id], onDelete: Cascade)
  Athlete       Athlete?      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([raceId])
  @@index([staffGeneratedId])
  @@map("race_announcements")
}

/// Race-day / training meetups tied to a race (mirrors run_crew_events).
model race_events {
  id                String   @id @default(cuid())
  raceId            String
  organizerId       String
  title             String
  date              DateTime
  time              String
  venue             String
  address           String?
  description       String?
  additionalDetails String?
  cost              Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  race_registry     race_registry      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  organizer         Athlete            @relation("RaceEventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  race_event_rsvps  race_event_rsvps[]

  @@index([raceId])
  @@index([date])
  @@map("race_events")
}

model race_event_rsvps {
  id        String   @id @default(cuid())
  eventId   String
  athleteId String
  status    String
  createdAt DateTime @default(now())

  race_events race_events @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Athlete     Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([eventId, athleteId])
  @@map("race_event_rsvps")
}

/// Free-form training journal entries (Runner OS).
model run_journal_entries {
  id        String   @id @default(cuid())
  athleteId String
  date      DateTime @default(now())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Athlete   Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([athleteId, date])
  @@map("run_journal_entries")
}

/// Athlete-level schedule / volume preferences (1:1), independent of any training plan.
model TrainingPreferences {
  id                   String   @id @default(cuid())
  athleteId            String   @unique
  preferredDays        Int[]
  weeklyMileageTarget  Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  Athlete              Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("training_preferences")
}

/// Public brand row — prodpush from Company acq_brands; slug is the bridge key.
model brands {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  brandType       BrandType @default(OTHER)
  description     String?
  websiteUrl      String?
  instagramHandle String?
  logoUrl         String?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  run_clubs       run_clubs[]

  @@map("brands")
}

model run_clubs {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  brandId   String?
  brands    brands?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  logoUrl      String?
  city         String?
  /// Canonical city slug (dc, arlington) — synced from Company prodpush; computed from city when set.
  citySlug     String?
  /// FK to cities — server-derived on save for city guide hydration.
  cityId       String?
  cities       cities?  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  /// HQ / central office from Google Places (affiliation canon).
  hqPlaceId          String?
  hqFormattedAddress String?
  hqStreet           String?
  hqZip              String?
  hqLat              Float?
  hqLng              Float?
  /// Club runs in multiple municipalities; series rows need per-row city from Places.
  isMultiSite  Boolean  @default(false)
  state        String?
  neighborhood String?
  description String?              // General club description (for downstream display)
  /// Short matcher token for Garmin title / inbound match (e.g. "DCCR").
  matchToken  String?
  allRunsDescription String?      // Overall description for this club's run series (not per individual run) — drives run_series.description
  websiteUrl String?
  runUrl    String?              // "Runs" page URL — single source of truth for where run/series info came from (seed/hydrate for data entry)
  instagramUrl String?
  stravaUrl String?              // Club Strava — source for AI; data entry can look up
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs                  city_runs[]
  groupWorkouts         workouts[]
  clubLeaders           Athlete[]                  // Reverse relation for Athlete.runClubId
  runSeries             run_series[]               // Recurring series this club owns (run_series.runClubId → run_clubs)
  run_club_memberships  run_club_memberships[]
  run_club_leader_claims  run_club_leader_claims[]
  run_club_announcements run_club_announcements[]
  run_club_events       run_club_events[]
  run_club_messages     run_club_messages[]

  @@index([brandId])
  @@index([city])
  @@index([cityId])
  @@index([citySlug])
  @@index([slug])
}

/// Club-level membership — join/follow the run club (separate from per-run RSVPs).
model run_club_memberships {
  id        String    @id @default(cuid())
  runClubId String
  athleteId String
  role      String    @default("member") // member | manager | admin (legacy owner)
  status    String    @default("active") // active | left | blocked
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  run_clubs run_clubs @relation(fields: [runClubId], references: [id], onDelete: Cascade)
  Athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([runClubId, athleteId])
  @@index([runClubId])
  @@index([athleteId])
  @@map("run_club_memberships")
}

/// Product-scoped athlete distinctions (non-authorizing). e.g. CLUB_LEADER, AMBASSADOR.
model athlete_product_roles {
  id        String      @id @default(cuid())
  athleteId String
  role      AthleteRole
  createdAt DateTime    @default(now())
  Athlete   Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, role])
  @@index([role])
  @@map("athlete_product_roles")
}

/// Pre-seeded club-owner slots from Company — athlete claims by verified email match.
model run_club_leader_claims {
  id                   String    @id @default(cuid())
  runClubId            String
  email                String
  membershipRole       String    @default("manager") // manager | admin
  status               String    @default("unclaimed") // unclaimed | claimed | revoked
  acqClubLeaderId      String?
  acqRunClubId         String?
  managerAssignmentId  String?
  inviteTokenHash      String?   @unique
  inviteExpiresAt      DateTime?
  lastInviteSentAt     DateTime?
  claimedByAthleteId   String?
  claimedAt            DateTime?
  source               String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  run_clubs            run_clubs @relation(fields: [runClubId], references: [id], onDelete: Cascade)
  Athlete              Athlete?  @relation(fields: [claimedByAthleteId], references: [id], onDelete: SetNull)

  @@unique([runClubId, email])
  @@index([email, status])
  @@index([runClubId])
  @@map("run_club_leader_claims")
}

/// Club broadcast content — announcements visible to members (and optionally public).
model run_club_announcements {
  id          String    @id @default(cuid())
  runClubId   String
  authorId    String
  title       String?
  body        String
  visibility  String    @default("members") // public | members
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  run_clubs   run_clubs @relation(fields: [runClubId], references: [id], onDelete: Cascade)
  Athlete     Athlete   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([runClubId, publishedAt])
  @@map("run_club_announcements")
}

/// Non-run club events: socials, clinics, sponsor activations, etc.
model run_club_events {
  id                   String                 @id @default(cuid())
  runClubId            String
  creatorId            String
  title                String
  description          String?
  eventType            String                 @default("social") // social | clinic | sponsor | volunteer | race | other
  startsAt             DateTime
  endsAt               DateTime?
  location             String?
  visibility           String                 @default("public") // public | members
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  run_clubs            run_clubs              @relation(fields: [runClubId], references: [id], onDelete: Cascade)
  Athlete              Athlete                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  run_club_event_rsvps run_club_event_rsvps[]

  @@index([runClubId, startsAt])
  @@map("run_club_events")
}

/// RSVPs for club events (separate from city_run_rsvps).
model run_club_event_rsvps {
  id              String          @id @default(cuid())
  eventId         String
  athleteId       String
  status          String          @default("going") // going | maybe | not-going
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  run_club_events run_club_events @relation(fields: [eventId], references: [id], onDelete: Cascade)
  Athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([eventId, athleteId])
  @@index([athleteId])
  @@map("run_club_event_rsvps")
}

/// Club-level chatter — persistent channel for members (not per-run silos).
model run_club_messages {
  id          String     @id @default(cuid())
  runClubId   String
  athleteId   String
  content     String
  linkedRunId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  run_clubs   run_clubs  @relation(fields: [runClubId], references: [id], onDelete: Cascade)
  Athlete     Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  linkedRun   city_runs? @relation(fields: [linkedRunId], references: [id], onDelete: SetNull)

  @@index([runClubId, createdAt])
  @@index([athleteId])
  @@index([linkedRunId])
  @@map("run_club_messages")
}

/// Per-athlete read cursor for Universal Chatter inbox unread counts.
model chatter_channel_reads {
  id          String   @id @default(cuid())
  athleteId   String
  channelType String   // run_club | run_crew | race_hub
  channelId   String
  lastReadAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Athlete     Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([athleteId, channelType, channelId])
  @@index([athleteId])
  @@map("chatter_channel_reads")
}

model run_crew_announcements {
  id         String    @id
  runCrewId  String
  authorId   String
  title      String
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  archivedAt DateTime? @db.Timestamp(6)
  Athlete    Athlete   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  run_crews  run_crews @relation(fields: [runCrewId], references: [id], onDelete: Cascade)
}

model run_crew_event_rsvps {
  id              String          @id
  eventId         String
  athleteId       String
  status          String
  createdAt       DateTime        @default(now())
  Athlete         Athlete         @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  run_crew_events run_crew_events @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, athleteId])
}

model run_crew_events {
  id                   String                 @id
  runCrewId            String
  organizerId          String
  title                String
  date                 DateTime
  time                 String
  address              String?
  description          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  additionalDetails    String?
  cost                 Int?
  venue                String
  run_crew_event_rsvps run_crew_event_rsvps[]
  Athlete              Athlete                @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  run_crews            run_crews              @relation(fields: [runCrewId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([runCrewId])
}

model run_crew_memberships {
  id        String      @id
  runCrewId String
  athleteId String
  joinedAt  DateTime    @default(now())
  createdAt DateTime    @default(now())
  updatedAt DateTime
  role      RunCrewRole @default(member)
  Athlete   Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  run_crews run_crews   @relation(fields: [runCrewId], references: [id], onDelete: Cascade)

  @@unique([runCrewId, athleteId])
  @@index([runCrewId, role])
}

model run_crew_messages {
  id        String    @id
  runCrewId String
  athleteId String
  content   String
  createdAt DateTime  @default(now())
  topic     String    @default("general")
  updatedAt DateTime
  Athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  run_crews run_crews @relation(fields: [runCrewId], references: [id], onDelete: Cascade)
}

model city_run_checkins {
  id          String    @id
  runId       String
  athleteId   String
  checkedInAt DateTime  @default(now())
  runPhotoUrl String?   // athlete's photo from this run
  runShouts   String?   // post-run shout-out / comment
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  city_runs   city_runs @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, athleteId])
  @@index([runId])
  @@index([athleteId])
  @@map("city_run_checkins")
}

model city_run_messages {
  id        String     @id
  runId     String
  athleteId String
  content   String
  topic     String     @default("general")
  createdAt DateTime   @default(now())
  updatedAt DateTime
  Athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  city_runs city_runs  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([athleteId])
  @@index([topic])
  @@map("city_run_messages")
}

/// Athlete–run roster junction (I'm in / going). One row per athlete per city run.
model city_run_rsvps {
  id              String        @id
  runId           String
  athleteId       String
  status          String        // "going", "not-going", "maybe"
  occurrenceDate  DateTime?     // null = standalone run; set = recurring (the specific occurrence date)
  checkedInAt     DateTime?     // Timestamp when checked in (null = not checked in)
  rsvpPhotoUrls   Json?         // Photos attendee posted for this run (ambassador credit when going + ≥1 photo)
  createdAt       DateTime      @default(now())
  Athlete         Athlete       @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  city_runs       city_runs     @relation(fields: [runId], references: [id], onDelete: Cascade)
  ambassador_credits ambassador_credits?

  @@unique([runId, athleteId])
  @@index([checkedInAt])
  @@index([occurrenceDate])
}

/// Reusable running route (Strava reference + media). Start/end for events stay on city_runs.
model routes {
  id                 String   @id @default(cuid())
  name               String
  stravaUrl          String?
  distanceMiles      Float?
  stravaMapUrl       String?
  mapImageUrl        String?
  routePhotos        Json?
  routeNeighborhood  String?
  runType            String?
  /// City slug for lookup (e.g. dc); city_runs.citySlug remains source of truth for the event.
  citySlug           String?
  cityId             String?
  cities             cities?  @relation(fields: [cityId], references: [id], onDelete: SetNull)
  createdByAthleteId String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          Athlete  @relation(fields: [createdByAthleteId], references: [id], onDelete: Cascade)
  city_runs          city_runs[]
  gofast_container_messages gofast_container_messages[]
  athlete_run_routes athlete_run_routes[]

  @@index([citySlug])
  @@index([cityId])
  @@index([name])
  @@map("routes")
}

model city_runs {
  id                  String               @id
  runCrewId           String?
  title               String
  date                DateTime
  timezone            String?
  meetUpPoint         String
  meetUpPlaceId       String?
  meetUpLat           Float?
  meetUpLng           Float?
  totalMiles          Float?
  pace                String?
  stravaMapUrl        String?              // Public Strava route URL shown on the run page
  description         String?
  postRunActivity     String?              // Post-run activity (e.g. "light social at X", "coffee at Y")
  postRunNote         String?              // Club manager published recap after the run
  postRunPhotoUrl     String?              // Club group/result photo (blob URL)
  postRunPublished    Boolean              @default(false)
  postRunPublishedAt  DateTime?
  routePhotos         Json?                // Array of photo URLs: ["url1", "url2", ...]
  mapImageUrl         String?              // Single map image URL (snip from Strava or uploaded)
  staffNotes          String?              // Data entry note for approver (e.g. "Couldn't get Strava URL")
  // Source inputs - capture ALL available sources for AI processing and traceability
  stravaEventUrl      String?              // Optional Strava event URL for description context
  stravaText          String?              // Optional pasted Strava event description
  webUrl              String?              // Web/website URL
  webText             String?              // Raw text blob from web (copy/paste)
  igPostText          String?              // Instagram post text (copy/paste)
  igPostGraphic       String?              // Instagram post image URL (uploaded blob)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  startTimeHour       Int?
  startTimeMinute     Int?
  startTimePeriod     String?
  runClubId           String?
  athleteGeneratedId  String?
  staffGeneratedId    String?
  citySlug            String
  cityId              String?
  cities              cities?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  slug                String?              @unique // URL-friendly slug: "title-of-run" (generated from title)
  dayOfWeek           String?
  workflowStatus      RunWorkflowStatus    @default(DEVELOP)
  /// Public discoverability — independent of workflowStatus editorial pipeline.
  published           Boolean              @default(false)
  endPoint            String?
  meetUpStreetAddress String?
  meetUpCity          String?
  meetUpState         String?
  meetUpZip           String?
  routeNeighborhood String?              // Neighborhood/area route goes through (e.g. "Arlington Heights", "Back Bay") - gives run flavor
  runType             String?              // Type of run location: "track", "trail", "neighborhood", "park"
  workoutDescription  String?              // Workout focus/description (e.g. "emphasizes speed training for those want to increase threshold")
  directionsText        String?              // Staff pasted route directions — copies forward on series advance
  endStreetAddress    String?
  endCity             String?
  endState            String?
  runSeriesId         String?              // null = standalone; set = series occurrence (FK to run_series)
  /// Optional: tag this run to a race registry (training for X marathon, etc.).
  raceRegistryId      String?
  /// Idempotent key for Company → prod shakeout sync (one row per race_run_event window). Null for normal city_runs.
  shakeoutDedupeKey   String?              @unique
  locationId          String?              // FK to run_locations (auto-seeded or manually linked)
  routeId             String?              // Optional saved route (reference path + media)
  workoutId           String?              // Optional structured workout for join-my-workout
  /// Club session prescribe template (athleteId null on linked planned_workouts row).
  plannedWorkoutId    String?              @unique
  /// Product behavior unlock: CLUB enables check-in, look-back, reminders.
  cityRunType         CityRunType          @default(OTHER)
  city_run_rsvps      city_run_rsvps[]
  city_run_messages   city_run_messages[]
  city_run_checkins   city_run_checkins[]
  city_run_activity_links city_run_activity_links[]
  run_club_messages_linked run_club_messages[]
  gofast_container_messages gofast_container_messages[]
  Athlete             Athlete?             @relation(fields: [athleteGeneratedId], references: [id], onDelete: Cascade)
  run_crews           run_crews?           @relation(fields: [runCrewId], references: [id], onDelete: Cascade)
  runClub             run_clubs?           @relation(fields: [runClubId], references: [id], onDelete: SetNull)
  runSeries           run_series?          @relation(fields: [runSeriesId], references: [id], onDelete: SetNull)
  race_registry       race_registry?       @relation("CityRunRaceRegistry", fields: [raceRegistryId], references: [id], onDelete: SetNull)
  location            run_locations?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  route               routes?              @relation(fields: [routeId], references: [id], onDelete: SetNull)
  workout             workouts?            @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  plannedWorkout      planned_workouts?    @relation("CityRunPlannedTemplate", fields: [plannedWorkoutId], references: [id], onDelete: SetNull)
  planned_workouts    planned_workouts[]   @relation("CityRunPlannedRows")

  @@index([athleteGeneratedId])
  @@index([citySlug])
  @@index([cityId])
  @@index([slug])
  @@index([date])
  @@index([dayOfWeek])
  @@index([workflowStatus])
  @@index([runClubId])
  @@index([runCrewId])
  @@index([staffGeneratedId])
  @@index([runSeriesId])
  @@index([raceRegistryId])
  @@index([locationId])
  @@index([routeId])
  @@index([workoutId])
  @@index([cityRunType])
  // Table name is city_runs (migrated from run_crew_runs). Explicit map so deployed builds never use old name.
  @@map("city_runs")
}

/// Expo push token per device — app notification delivery endpoints only (not inbox content).
model athlete_appnotification_devices {
  id            String   @id @default(cuid())
  athleteId     String
  expoPushToken String   @unique
  platform      String?
  deviceId      String?
  enabled       Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Athlete       Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
}

model run_series {
  id                  String               @id
  slug                String?              @unique // URL-friendly e.g. "dc-run-crew-tuesday" (club slug + day)
  dayOfWeek           String               // "MONDAY" | "TUESDAY" | ... | "SUNDAY" (canonical)
  runClubId           String?              // which club owns this recurring series
  name                String?              // series label, e.g. "Tuesday Tempo"
  description         String?              // series blurb — seeds each new occurrence's description
  seriesRunRawText    String?              // series-specific raw text (neighborhood, meetup details, etc.) — persisted
  citySlug            String?              // city slug (e.g. "dc", "arlington") — same for all occurrences
  cityId              String?
  cities              cities?              @relation(fields: [cityId], references: [id], onDelete: SetNull)
  meetUpPoint         String?              // canonical meeting location name (same corner every week)
  meetUpStreetAddress String?
  meetUpCity          String?
  meetUpState         String?
  meetUpPlaceId       String?
  meetUpLat           Float?
  meetUpLng           Float?
  runType             String?              // "track" | "trail" | "neighborhood" | "park" — seeds city_runs.runType
  totalMiles          Float?               // typical distance — seeds city_runs.totalMiles
  routeNeighborhood   String?              // route/area context — seeds city_runs.routeNeighborhood
  workoutDescription  String?              // workout focus — seeds city_runs.workoutDescription
  postRunActivity     String?              // post-run social — seeds city_runs.postRunActivity
  endPoint            String?              // end/finish location (null = same as meetUpPoint)
  endStreetAddress    String?
  endCity             String?
  endState            String?
  startTimeHour       Int?                 // canonical run time (same every week)
  startTimeMinute     Int?
  startTimePeriod     String?              // "AM" | "PM"
  startDate           DateTime?            // when this series began; null = from whenever
  endDate             DateTime?            // when this series ends; null = forever
  workflowStatus      RunWorkflowStatus    @default(DEVELOP)  // mirrors city_runs: DEVELOP → PENDING → SUBMITTED → APPROVED
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  city_runs           city_runs[]
  runClub             run_clubs?           @relation(fields: [runClubId], references: [id], onDelete: SetNull)

  @@index([runClubId])
  @@index([citySlug])
  @@index([cityId])
  @@index([dayOfWeek])
  @@index([workflowStatus])
  @@map("run_series")
}


model run_crew_specific_races {
  id             String        @id
  runCrewId      String
  raceRegistryId String
  createdAt      DateTime      @default(now())
  race_registry  race_registry @relation(fields: [raceRegistryId], references: [id], onDelete: Cascade)
  run_crews      run_crews     @relation(fields: [runCrewId], references: [id], onDelete: Cascade)

  @@unique([runCrewId, raceRegistryId])
}

model run_crews {
  id                      String                    @id
  name                    String
  description             String?
  joinCode                String                    @unique
  logo                    String?
  icon                    String?
  archivedAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  messageTopics           Json?
  city                    String?
  ageMin                  Int?
  ageMax                  Int?
  primaryMeetUpPoint      String?
  primaryMeetUpAddress    String?
  primaryMeetUpPlaceId    String?
  primaryMeetUpLat        Float?
  primaryMeetUpLng        Float?
  gender                  Gender?
  state                   State?
  typicalRunMiles         Float?
  longRunMilesMin         Float?
  longRunMilesMax         Float?
  timePreference          TimePreference[]          @default([])
  purpose                 Purpose[]                 @default([])
  trainingForRace         String?
  trainingForDistance     TrainingForDistance[]     @default([])
  easyMilesPace           Int?
  crushingItPace          Int?
  handle                  String                    @unique
  join_codes              join_codes[]
  run_crew_announcements  run_crew_announcements[]
  run_crew_events         run_crew_events[]
  run_crew_memberships    run_crew_memberships[]
  run_crew_messages       run_crew_messages[]
  city_runs               city_runs[]
  run_crew_specific_races run_crew_specific_races[]
  race_registry           race_registry?            @relation(fields: [trainingForRace], references: [id])
}

/// Top-level generation preset (e.g. Elite Marathon, Basic, Marine Corps Marathon).
enum AthletePersonaCapability {
  NON_RUNNER
  BEGINNER
  RECREATIONAL
  COMPETITIVE
  ELITE
}

enum AthletePersonaDedication {
  LOW
  MODERATE
  HIGH
  ELITE
}

enum FitnessDelta {
  SMALL
  MODERATE
  LARGE
}

enum ProgressionAggressiveness {
  CONSERVATIVE
  MODERATE
  AMBITIOUS
}

enum TrainingPlanGoalKind {
  RACE
  TRAINING_BLOCK
}

enum TrainingPlanGoalType {
  RACE
  GENERAL_FITNESS
  MORE_ENDURANCE
}

/// Reusable athlete archetype — time-agnostic slug (e.g. new-5k-improve).
model training_plan_persona {
  id                  String                    @id @default(cuid())
  slug                String                    @unique
  title               String
  capability          AthletePersonaCapability?
  dedication          AthletePersonaDedication?
  personaGoalLabel    String?
  workoutFrequencyCap Int?
  intentSummary       String?
  /// Text-first persona fields (canonical truth for matching).
  runningHistory                  String?
  runningHistorySummary           String?
  currentCapability               String?
  currentCapabilitySummary        String?
  injuryAssessment                String?
  injuryAssessmentSummary         String?
  dedicationText                  String?
  dedicationSummary               String?
  abilityToTrain                  String?
  abilityToTrainSummary           String?
  estimated5kTimeSeconds          Int?
  estimated5kPerformanceSummary   String?
  estimated5kPerformanceRationale String?
  athletePersonaSummary           String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  goals   training_plan_goal[]
  presets training_plan_preset[]
  swim_presets swim_plan_preset[]

  @@index([capability])
}

/// Bounded goal with time horizon — slug includes weeks (e.g. new-5k-improve-12w).
model training_plan_goal {
  id                        String                      @id @default(cuid())
  slug                      String                      @unique
  personaId                 String
  persona                   training_plan_persona       @relation(fields: [personaId], references: [id], onDelete: Restrict)
  targetDistanceLabel       String?
  objectiveOfPlan           String?
  planDurationWeeks         Int
  timeHorizonLabel          String?
  fitnessDelta              FitnessDelta?
  progressionAggressiveness ProgressionAggressiveness?
  intensityReasoning        String?
  goalKind                  TrainingPlanGoalKind?
  goalType                  TrainingPlanGoalType?
  coachIntent               String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  presets training_plan_preset[]
  swim_presets swim_plan_preset[]

  @@index([personaId])
  @@index([planDurationWeeks])
}

model training_plan_preset {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  /// Shown to athletes on preset selection; internal notes stay in `description`.
  publicDescription String?
  /// Canonical distance label (e.g. "Marathon") from COMMON_RACE_DISTANCE_PRESETS; null = any distance.
  targetDistanceLabel String?

  personaId String?
  goalId    String?
  persona   training_plan_persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  goal      training_plan_goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  /// Staff/coach free-text intent that drove preset design (AI or manual).
  coachIntent String?
  /// What this plan is trying to achieve, e.g. "First 5K finish" or "Marathon BQ attempt".
  objectiveOfPlan String?
  athletePersonaCapability AthletePersonaCapability?
  athletePersonaGoal String?
  athletePersonaDedication AthletePersonaDedication?
  /// Generation-useful overview: volume, composition, long-run / quality structure families.
  coachPlanOverview Json?
  /// Enabled workout types, weekly counts, cadence — canonical structure snapshot.
  workoutStructure Json?

  /// Long-run rotation block: one long run per week for this many consecutive weeks (LR1…LRn) before the pattern repeats; product always 4.
  longRunCycleWeeks  Int    @default(4)
  minWeeklyMiles     Int    @default(40)
  maxWeeklyMiles     Int?
  /// Base-block long-run POOL — sum of 4 Saturday LRs in that block. Not weekly mileage.
  baseLongRunPoolMiles  Float
  /// Peak-block long-run POOL — sum of 4 Saturday LRs in the peak block. Not weekly mileage.
  peakLongRunPoolMiles  Float
  /// Taper-block long-run POOL — sum of 4 Saturday LRs in the taper block. Not weekly mileage.
  taperLongRunPoolMiles Float
  tempoIdealDow      Int    @default(2)
  intervalIdealDow   Int    @default(4)
  longRunDefaultDow  Int    @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  longRunConfigId   String?
  longRunConfig     long_run_config?   @relation(fields: [longRunConfigId], references: [id], onDelete: SetNull)
  intervalsConfigId String?
  intervalsConfig   intervals_config?  @relation(fields: [intervalsConfigId], references: [id], onDelete: SetNull)
  tempoConfigId     String?
  tempoConfig       tempo_config?      @relation(fields: [tempoConfigId], references: [id], onDelete: SetNull)
  easyConfigId      String?
  easyConfig        easy_config?       @relation(fields: [easyConfigId], references: [id], onDelete: SetNull)
  /// JSON: standardMiles, minMiles, paceOffsetSecPerMile, weeklyTargetBufferMiles (easy-day defaults / pace vs 5K anchor)
  easyRunConfig     Json?
  training_plans  training_plans[]
  training_cohorts training_cohorts[]
  public_training_plans public_training_plans[]
  athlete_presets_as_source athlete_presets[] @relation("AthletePresetSource")
  athlete_presets_as_promoted athlete_presets[] @relation("AthletePresetPromoted")
}

/// Athlete-owned training blueprint — never mixed into staff catalog until promoted.
model athlete_presets {
  id              String   @id @default(cuid())
  athleteId       String
  title           String
  description     String?
  objectiveOfPlan String?

  longRunCycleWeeks Int    @default(4)
  minWeeklyMiles    Int    @default(40)
  maxWeeklyMiles    Int?
  baseLongRunPoolMiles  Float
  peakLongRunPoolMiles  Float
  taperLongRunPoolMiles Float
  tempoIdealDow     Int    @default(2)
  intervalIdealDow  Int    @default(4)
  longRunDefaultDow Int    @default(6)

  trainingHistory  String?
  fitnessPhase     AthletePresetFitnessPhase @default(BASE)
  /// Inferred from free-text history by first OpenAI prompt — not an athlete form picker.
  progressionAggressiveness ProgressionAggressiveness?
  ageYearsSnapshot Int?
  genderSnapshot   String?

  /// Biggest single Saturday inside the peak long-run pool.
  longestSaturdayMiles Float?
  peakLongRunDate      DateTime?
  taperStartDate       DateTime?
  trainingStartDate    DateTime?
  raceDateSnapshot     DateTime?

  /// Generation-useful overview: volume, composition, long-run / quality structure families.
  coachPlanOverview Json?
  /// Enabled workout types, weekly counts, cadence — canonical structure snapshot.
  workoutStructure Json?
  /// JSON: standardMiles, minMiles, paceOffsetSecPerMile, weeklyTargetBufferMiles (easy-day defaults)
  easyRunConfig Json?

  sourcePresetId   String?
  promotedPresetId String?

  longRunConfigId   String?
  longRunConfig     long_run_config?   @relation(fields: [longRunConfigId], references: [id], onDelete: SetNull)
  intervalsConfigId String?
  intervalsConfig   intervals_config?  @relation(fields: [intervalsConfigId], references: [id], onDelete: SetNull)
  tempoConfigId     String?
  tempoConfig       tempo_config?      @relation(fields: [tempoConfigId], references: [id], onDelete: SetNull)
  easyConfigId      String?
  easyConfig        easy_config?       @relation(fields: [easyConfigId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete          Athlete               @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sourcePreset     training_plan_preset? @relation("AthletePresetSource", fields: [sourcePresetId], references: [id], onDelete: SetNull)
  promotedPreset   training_plan_preset? @relation("AthletePresetPromoted", fields: [promotedPresetId], references: [id], onDelete: SetNull)
  training_plans   training_plans[]
  longRunOrders    athlete_preset_long_run_order[]
  easyOrders       athlete_preset_easy_order[]
  athleteTempoConfig     athlete_tempo_config?
  athleteIntervalsConfig athlete_intervals_config?

  @@index([athleteId])
  @@index([sourcePresetId])
  @@map("athlete_presets")
}

/// Athlete-specific order over shared long_run_config_position rows (MVP1: config unchanged).
model athlete_preset_long_run_order {
  id                      String @id @default(cuid())
  athletePresetId         String
  longRunConfigPositionId String
  cyclePosition           Int

  athlete_preset           athlete_presets           @relation(fields: [athletePresetId], references: [id], onDelete: Cascade)
  long_run_config_position long_run_config_position @relation(fields: [longRunConfigPositionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athletePresetId, longRunConfigPositionId])
  @@unique([athletePresetId, cyclePosition])
  @@index([athletePresetId])
  @@index([longRunConfigPositionId])
}

/// Athlete-specific order over shared easy_config_position rows.
model athlete_preset_easy_order {
  id                   String @id @default(cuid())
  athletePresetId      String
  easyConfigPositionId String
  cyclePosition        Int

  athlete_preset      athlete_presets      @relation(fields: [athletePresetId], references: [id], onDelete: Cascade)
  easy_config_position easy_config_position @relation(fields: [easyConfigPositionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athletePresetId, easyConfigPositionId])
  @@unique([athletePresetId, cyclePosition])
  @@index([athletePresetId])
  @@index([easyConfigPositionId])
}

/// Athlete-owned tempo rotation — eight catalogue workouts.
model athlete_tempo_config {
  id              String @id @default(cuid())
  athletePresetId String @unique

  athlete_preset athlete_presets @relation(fields: [athletePresetId], references: [id], onDelete: Cascade)
  positions      athlete_tempo_config_position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model athlete_tempo_config_position {
  id                   String @id @default(cuid())
  athleteTempoConfigId String
  cyclePosition        Int
  distributionWeight   Float  @default(0.125)
  catalogueWorkoutId   String?

  athlete_tempo_config athlete_tempo_config @relation(fields: [athleteTempoConfigId], references: [id], onDelete: Cascade)
  workout_catalogue    workout_catalogue?   @relation(fields: [catalogueWorkoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteTempoConfigId, cyclePosition])
  @@index([athleteTempoConfigId])
}

/// Athlete-owned intervals rotation — eight catalogue workouts.
model athlete_intervals_config {
  id              String @id @default(cuid())
  athletePresetId String @unique

  athlete_preset athlete_presets @relation(fields: [athletePresetId], references: [id], onDelete: Cascade)
  positions      athlete_intervals_config_position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model athlete_intervals_config_position {
  id                       String @id @default(cuid())
  athleteIntervalsConfigId String
  cyclePosition            Int
  distributionWeight       Float  @default(0.125)
  catalogueWorkoutId       String?

  athlete_intervals_config athlete_intervals_config @relation(fields: [athleteIntervalsConfigId], references: [id], onDelete: Cascade)
  workout_catalogue          workout_catalogue?       @relation(fields: [catalogueWorkoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([athleteIntervalsConfigId, cyclePosition])
  @@index([athleteIntervalsConfigId])
}

/// Standalone swim training preset — separate from run `training_plan_preset`; future triathlon presets compose swim/bike/run.
model swim_plan_preset {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  publicDescription String?
  /// Race or benchmark swim distance in meters (e.g. 1900 Olympic, 3800 IM).
  goalSwimDistanceMeters Int?

  personaId String?
  goalId    String?
  persona   training_plan_persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)
  goal      training_plan_goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  coachIntent String?
  objectiveOfPlan String?
  athletePersonaCapability AthletePersonaCapability?
  athletePersonaGoal String?
  athletePersonaDedication AthletePersonaDedication?
  coachPlanOverview Json?
  /// Enabled swim workout types, weekly counts, cadence — canonical structure snapshot.
  workoutStructure Json?

  /// Repeating cycle length for rotation configs (weeks); product always 4.
  longRunCycleWeeks Int @default(4)
  /// JSON: per-week multipliers within a cycle, e.g. { "weekMultipliers": [1, 1.05, 1.1, 0.85] }.
  weeklyProgressionPattern Json?
  /// recommendedWeeklyMeters = goalSwimDistanceMeters × recommendationMultiplier when goal is set.
  recommendationMultiplier Float @default(4)
  recommendedWeeklyMeters Int?
  minWeeklyMeters Int @default(4000)
  maxWeeklyMeters Int?

  taperWeeks Int @default(2)
  /// Fraction of normal weekly meters during taper (e.g. 0.5 ≈ 50% volume).
  taperVolumeMultiplier Float @default(0.5)

  /// Long swim derived from weekly total — not the volume anchor.
  longSwimShareOfWeek Float?
  longSwimMinMeters Int?
  longSwimMaxMeters Int?

  enduranceIdealDow  Int @default(2)
  thresholdIdealDow Int @default(4)
  powerIdealDow      Int @default(3)
  longSwimIdealDow   Int @default(6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enduranceConfigId  String?
  enduranceConfig    swim_rotation_config? @relation("SwimPresetEndurance", fields: [enduranceConfigId], references: [id], onDelete: SetNull)
  thresholdConfigId  String?
  thresholdConfig    swim_rotation_config? @relation("SwimPresetThreshold", fields: [thresholdConfigId], references: [id], onDelete: SetNull)
  powerConfigId      String?
  powerConfig        swim_rotation_config? @relation("SwimPresetPower", fields: [powerConfigId], references: [id], onDelete: SetNull)
  longSwimConfigId   String?
  longSwimConfig     swim_rotation_config? @relation("SwimPresetLongSwim", fields: [longSwimConfigId], references: [id], onDelete: SetNull)
}

/// Swim workout catalogue — first-class taxonomy (EnduranceSwim, ThresholdSwim, PowerSwim, LongSwim).
model swim_workout_catalogue {
  id          String          @id @default(cuid())
  name        String
  slug        String?         @unique
  description String?
  workoutType SwimWorkoutType
  /// Total prescribed work distance when fixed (meters).
  totalWorkDistanceMeters Int?
  repDistanceMeters       Int?
  repCount                Int?
  recoverySeconds         Int?
  recoveryMeters          Int?
  warmupMeters            Int?
  cooldownMeters          Int?
  /// Offset from athlete FourHunMSwPace (sec/100m) for main work.
  paceOffsetSecPer100m    Int?
  /// Optional JSON segment ladder / block-repeat pattern.
  segmentPattern          Json?
  trainingIntent          String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  rotationPositions swim_rotation_config_position[]

  @@unique([name, workoutType])
  @@index([workoutType])
