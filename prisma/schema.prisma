  thresholdPresets swim_plan_preset[] @relation("SwimPresetThreshold")
  powerPresets     swim_plan_preset[] @relation("SwimPresetPower")
  longSwimPresets  swim_plan_preset[] @relation("SwimPresetLongSwim")

